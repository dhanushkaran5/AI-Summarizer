{
  "manifest_version": 3,
  "name": "Summarize AI — Intelligent Web Summarizer",
  "version": "1.0.0",
  "description": "Turn long web content into clear, intelligent understanding with hybrid extractive-abstractive AI.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "http://localhost:8080/*",
    "http://127.0.0.1:8080/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Summarize with Summarize AI"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
